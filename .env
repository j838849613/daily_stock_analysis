# 1. 声明开启的所有渠道
LLM_CHANNELS=gemini,anthropic,deepseek,aihubmix

# 2. 设置首选主力模型 (Gemini 3 Flash Preview)
LITELLM_MODEL=gemini/gemini-3-flash-preview

# 3. 设置后备模型顺序 (Gemini挂了找Claude，Claude也挂了找DeepSeek)
# 注意：DeepSeek Reasoner 逻辑更强，推荐用于股票分析
LITELLM_FALLBACK_MODELS=anthropic/claude-3-5-sonnet-20241022,deepseek/deepseek-reasoner

# ---------------------------------------------------------
# 各平台具体模型配置
# ---------------------------------------------------------
# Gemini 配置
LLM_GEMINI_MODELS=gemini/gemini-3-flash-preview
LLM_GEMINI_API_KEY=AIzaSyBwq9XHy8Mblj_B19-Tk_20vL2aICGbwUQ

# Claude 配置 (目前最聪明的模型之一)
ANTHROPIC_API_KEY=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
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# DeepSeek 配置 (伪装成 OpenAI 格式)
